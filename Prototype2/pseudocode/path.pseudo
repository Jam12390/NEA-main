class TopDownNode
    public coord
    public shortestDistance
    private __heuristic
    public previousNode
    public nextNodes
    public visited

    public procedure new(pCoord, pShortestDistance, targetCoord, pPreviousNode=null)
        coord = pCoord
        shortestDistance = pShortestDistance
        __heuristic = ((targetCoord[0] - coord[0]) ^ 2 + (targetCoord[1] - coord[1]) ^ 2) ^ 0.5
        previousNode = pPreviousNode
        nextNodes = []
        visited = false
    endprocedure
    
    public function getHeuristic()
        return __heuristic
    endfunction
endclass // contains base data about each node

class Stack
    private __data

    public procedure new()
        __data = [] // list
    endprocedure

    public procedure push(data)
        __data.append(data)
    endprocedure

    public function peek()
        return __data[__data.length - 1] // end value
    endfunction

    public function pop() // removes end value and returns it
        temp = __data[__data.length - 1]
        __data.pop(data.length - 1)
        return temp
    endfunction

    public function isEmpty()
        return data.length == 0
    endfunction
endclass

function getNextNodeToVisit(availableNodes)
    // sorts availableNodes by __heuristic + shortestDistance, choosing the lowest value which hasn't been visited
    // returns the index of this object, -1 if no node is found
    pass

function getAdjacentNodes(node, graph)
    // gets the top, left, down and right nodes around the current node, provided they are free
    // returns a list of coords in the form [(y, x), (y, x), ...]
    pass

function checkCoordPresence(availableNodes, query) // query => (y, x). Checks if a node exists, returns bool whereas indexNode returns an int
    for int i=0 to availableNodes.length - 1
        if availableNodes[i].coord == query:
            return true
        endif
    next i
    return false
endfunction

function indexNode(list, query) // gets the index of a queried coord, returning -1 if the node doesn't exist (used for lists of objects)
    for i=0 to list.length - 1
        if list[i].coord == query:
            return i
        endif
    next i
    return -1
endfunction

function cascadeUpdate(nodes, startNode): // recursive function which reduces all of startNode's neighbours' shortestDistance attributes
    for node in startNode.nextNodes:
        index = indexNode(nodes, node.coord)
        nodes[index].shortestDistance = startNode.shortestDistance + 1
        nodes = cascadeUpdate(nodes, nodes[index])
    next node
    return nodes // returns the updated list
endfunction

function getAbsolutePath( // A* pathing algorithm
    startNode,
    endNode, // => (y, x)
    graph // unsorted list of all valid nodes
):
    availableNodes = [
        new TopDownNode(
            startNode,
            0,
            endNode
        )
    ]
    nextNode = getNextNodeToVisit(availableNodes) // start at startNode
    while nextNode != -1:
        currentNode = availableNodes[nextNode]

        adjNodes = getAdjacentNodes(currentNode.coord, graph)
        newDist = currentNode.shortestDistance + 1

        for i=0 to adjNodes.length:
            if checkCoordPresence(availableNodes, adjNodes[i]): // if the object already exists in the list
                index = indexNode(availableNodes, adjNodes[i]) // index it
                if availableNodes[index].shortestDistance > newDist:
                    availableNodes[index].shortestDistance = newDist // and update its shortestDistance if our newDist is lower
                    availableNodes = cascadeUpdate(availableNodes, availableNodes[index]) // update neighbours
                    availableNodes[nextNode].nextNodes.append(adjNodes[i]) // and add its coordinate to currentNode's nextNode list
                endif
            else:
                availableNodes.append( // otherwise add the object as a new node
                    new TopDownNode(
                        adjNodes[i],
                        availableNodes[index].shortestDistance + 1,
                        endNode.coord,
                        availableNodes[index].coord
                    )
                )
                availableNodes[nextNode].nextNodes.append(adjNodes[i])

                if adjNodes[i] == endNode:
                    break // leave the loop if any node leads to endNode
                endif
            endif
        next i

        nextNode = getNextNodeToVisit(availableNodes) // find the next node to travel to
    endwhile

    if nextNode != -1:
        pathStack = new Stack

        currentCoord = endNode
        currentNode = availableNodes[indexNode(availableNodes, endNode)]

        while currentCoord != startNode: // iterate through previousNodes until we reach the start
            pathStack.push(currentCoord)

            currentCoord = currentNode.previousNode
            currentNode = availableNodes[indexNode(availableNodes, currentCoord)]
        endwhile

        pathStack.push(startNode)

        reversePath = []

        while NOT pathStack.isEmpty(): // use the stack's FILO nature to reverse the path (since it's currently back to front)
            toAdd = pathStack.pop()
            if NOT toAdd in reversePath:
                reversePath.append(toAdd)
            endif
        endwhile

        return reversePath
    else:
        return [] // empty (invalid) path
endfunction //leads to verify in development
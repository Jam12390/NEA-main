class Description inherits pygame.sprite.Sprite
    private __font
    private __titleFont

    public lines

    public background
    public rect

    public procedure new(position, text, font="calibri", backgroundColour=pygame.Color(175,175,175)):
        __font = font
        __titleFont = font // but with different size

        lines = wrapText(text)

        background = pygame.Surface() // insert size here (likely from lines)
        background.fill(backgroundColour)
        rect = pygame.Surface.get_rect(background)
    endprocedure
endclass

class ImageButton inherits pygame.sprite.Sprite
    public data

    public image
    public surface
    public rect

    public colour
    public hoveredOver
    public hoverColour
    public hoverOffset
    public onClick

    public description

    public procedure new(
        pData=None,
        position,
        imgPath,
        func,
        text,
        buttonColour=pygame.Color(175,175,175),
        pHoverColour=pygame.Color(60,60,60),
        pHoverOffset=pygame.Vector2(0,0),
        size,
        descriptionOffset=pygame.Vector2(0,0),
        absoluteDescriptionPosition=None,
        titleFirst=False
    ):
        data = pData

        image = // load sprite from imgPath
        surface = pygame.Surface(size)

        //draw image onto surface

        rect = pygame.Surface.get_rect(surface)
        rect.center = position

        hoveredOver = False
        hoverColour = pHoverColour
        hoverOffset = pHoverOffset

        colour = buttonColour
        onClick = func

        if absoluteDescriptionPosition == None then
            description = Description(position + descriptionOffset, text)
        else:
            description = Description(absoluteDescriptionPosition, text)
        endif
    endprocedure

    public procedure checkForHover():
        pass // use logic from previous prototypes
    endprocedure

    public procedure update():
        checkForHover()
        pass // redraw (mostly the same as TextButton)
    endprocedure
endclass